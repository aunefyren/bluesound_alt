<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings pageId="audio" schemaVersion="36">
	<menuGroup id="audio" defaults="false" displayName="Audio" icon="/images/settings/ic_audio.png" url="http://192.0.2.1:11000/audiomodes">
		<setting id="eq-balance" name="eq-balance" displayName="Balance" url="http://192.0.2.1:11000/alsa_setting" icon="/images/settings/ic_balance.png" class="range" value="0" hideIfDisabled="true" style="balance">
			<value min="-7" max="7" step="0.5"></value>
		</setting>
		<setting id="eq-switch" name="eq-switch" displayName="Tone Controls" url="http://192.0.2.1:11000/alsa_setting" icon="/images/settings/ic_eqonoff.png" class="boolean" value="OFF" hideIfDisabled="true"></setting>
		<setting id="eq-treble" name="eq-treble" displayName="Treble" url="http://192.0.2.1:11000/alsa_setting" icon="/images/settings/icon_treble.png" class="range" value="0" hideIfDisabled="true">
			<value min="-6" max="6" step="0.5" units="dB"></value>
			<dependsOn name="eq-switch" value="ON"></dependsOn>
		</setting>
		<setting id="eq-bass" name="eq-bass" displayName="Bass" url="http://192.0.2.1:11000/alsa_setting" icon="/images/settings/icon_bass.png" class="range" value="0" hideIfDisabled="true">
			<value min="-6" max="6" step="0.5" units="dB"></value>
			<dependsOn name="eq-switch" value="ON"></dependsOn>
		</setting>
		<setting id="subwoofer" name="subwoofer" displayName="Subwoofer" url="http://192.0.2.1:11000/audiomodes" icon="/images/settings/icon_subwoofer.png" class="boolean" value="default">
			<value displayName="Off" name="default"></value>
			<value displayName="On" name="withsub"></value>
		</setting>
		<setting id="eq-crossover" name="eq-crossover" displayName="Crossover" url="http://192.0.2.1:11000/alsa_setting" icon="/images/settings/ic_crossover.png" class="range" value="80" hideIfDisabled="true">
			<value min="40" max="200" step="10" units="Hz"></value>
		</setting>
		<setting id="replayGainMode" name="replayGainMode" displayName="Replay-gain" url="http://192.0.2.1:11000/audiomodes" icon="/images/settings/ic_replaygain.png" class="list" value="none" description="Disabled">
			<value displayName="Disabled" name="none"></value>
			<value displayName="Track gain" name="track"></value>
			<value displayName="Album gain" name="album"></value>
			<value displayName="Smart gain" name="smart"></value>
		</setting>
		<setting id="channelMode" name="channelMode" displayName="Output mode" url="http://192.0.2.1:11000/audiomodes" icon="/images/settings/ic_channelmode.png" class="list" value="default" description="Stereo" hideIfDisabled="true">
			<value displayName="Stereo" name="default"></value>
			<value displayName="Left" name="left"></value>
			<value displayName="Right" name="right"></value>
			<value displayName="Mono" name="mono"></value>
		</setting>
		<setting id="volumeLimits" name="volumeLimits" displayName="Volume limits (dB)" url="http://192.0.2.1:11000/audiomodes" icon="/images/settings/ic_volumelimits.png" class="dual-range" value="-70,-20" hideIfDisabled="true">
			<value min="-80" max="0" minRange="30" units="dB"></value>
		</setting>
		<setting id="reset" name="reset" displayName="Reset All" url="http://192.0.2.1:11000/alsa_setting" icon="/images/settings/icon_reset.png" class="button" style="center"></setting>
	</menuGroup>
</settings>